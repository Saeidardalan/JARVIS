<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/openAiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OpenAI API Key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/geminiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini API Key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/qwenKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Qwen API Key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/mistralKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mistral API Key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/llamaKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Llama API Key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/claudeKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Claude API Key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/elevenLabsKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ElevenLabs API Key"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

    </LinearLayout>
</ScrollView>